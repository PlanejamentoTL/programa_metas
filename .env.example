# Copie para .env e preencha com os valores do app web "Página pública"
# (Console do Firebase > Configurações do projeto > Seus apps).
# Esses valores não são segredos: vão para o navegador. Quem protege os dados
# são as Security Rules. NUNCA coloque aqui credenciais de conta de serviço.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (opcional, desligado por padrão)
VITE_APP_CHECK_ATIVO=false
VITE_RECAPTCHA_SITE_KEY=
# v3 ou enterprise
VITE_RECAPTCHA_TIPO=v3
